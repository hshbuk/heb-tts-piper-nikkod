{
  "manifest_version": 3,
  "name": "Heb-TTS Reader",
  "version": "1.0",
  "description": "הקראת טקסטים בעברית ואנגלית באמצעות שרת ה-Flask המקומי.",
  "permissions": [
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
